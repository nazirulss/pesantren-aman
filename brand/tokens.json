{
  "name": "Pesantren Aman Design System Tokens",
  "version": "1.0.0",
  "officialLogo": {
    "status": "APPROVED",
    "concept": "Institutional Shield (Perisai Amanah)",
    "description": "Perisai simetris berkubah pesantren dengan lembaran kitab syariat dan bintang emas amanah.",
    "files": {
      "horizontal": "brand/logos/official/logo-primary-horizontal.svg",
      "vertical": "brand/logos/official/logo-primary-vertical.svg",
      "mark": "brand/logos/official/logo-mark.svg",
      "white": "brand/logos/official/logo-white.svg",
      "monochrome": "brand/logos/official/logo-monochrome-dark.svg"
    }
  },
  "color": {
    "primary": {
      "forestGreen": {
        "hex": "#145A42",
        "rgb": "rgb(20, 90, 66)",
        "cmyk": "cmyk(88, 38, 76, 38)",
        "role": "Identitas utama, wibawa, ketenangan spiritual pesantren"
      },
      "forestGreenDark": {
        "hex": "#0E4331",
        "rgb": "rgb(14, 67, 49)",
        "cmyk": "cmyk(90, 45, 80, 55)",
        "role": "Surface gelap, header cetak, kontras tinggi"
      },
      "forestGreenLight": {
        "hex": "#1E7356",
        "rgb": "rgb(30, 115, 86)",
        "role": "Hover state, aksen pendukung"
      }
    },
    "secondary": {
      "emeraldHope": {
        "hex": "#23966B",
        "rgb": "rgb(35, 150, 107)",
        "cmyk": "cmyk(78, 9, 70, 1)",
        "role": "Pertumbuhan santri, edukasi positif, tombol aksi sekunder"
      },
      "emeraldLight": {
        "hex": "#E8F5F0",
        "rgb": "rgb(232, 245, 240)",
        "role": "Background badge, highlight pilar edukasi"
      }
    },
    "accent": {
      "softGold": {
        "hex": "#C7A45B",
        "rgb": "rgb(199, 164, 91)",
        "cmyk": "cmyk(23, 33, 76, 2)",
        "role": "Amanah, kehormatan, aksen bintang, border piagam komitmen"
      },
      "goldLight": {
        "hex": "#F7F2E7",
        "rgb": "rgb(247, 242, 231)",
        "role": "Highlight hangat pada kartu dan dokumen"
      }
    },
    "neutral": {
      "parchmentCream": {
        "hex": "#F4F0E6",
        "rgb": "rgb(244, 240, 230)",
        "cmyk": "cmyk(4, 5, 10, 0)",
        "role": "Latar belakang hangat, kesan kertas klasik kitab kuning"
      },
      "pureWhite": {
        "hex": "#FFFFFF",
        "rgb": "rgb(255, 255, 255)",
        "role": "Kartu, kontainer, kontras terang"
      },
      "slatePeat": {
        "hex": "#232E28",
        "rgb": "rgb(35, 46, 40)",
        "role": "Teks judul dan isi utama (keterbacaan optimal tanpa hitam pekat)"
      },
      "mutedSlate": {
        "hex": "#5A6D63",
        "rgb": "rgb(90, 109, 99)",
        "role": "Teks sekunder, label formulir, keterangan footnote"
      },
      "borderMuted": {
        "hex": "#DCE3DE",
        "rgb": "rgb(220, 227, 222)",
        "role": "Garis batas tabel, pemisah konten, kartu"
      }
    },
    "semantic": {
      "success": {
        "hex": "#1E8E5A",
        "role": "Status selesai, kepatuhan terpenuhi, aksi 90 hari tuntas"
      },
      "warning": {
        "hex": "#D97706",
        "role": "Status dalam proses, catatan pendampingan, butuh penyesuaian"
      },
      "danger": {
        "hex": "#DC2626",
        "role": "Risiko tinggi, penanganan khusus, SOP darurat"
      },
      "info": {
        "hex": "#2563EB",
        "role": "Informasi regulasi, rujukan mitra, bantuan hukum"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "display": "'Plus Jakarta Sans', system-ui, -apple-system, sans-serif",
      "body": "'Inter', system-ui, -apple-system, sans-serif",
      "mono": "'JetBrains Mono', monospace"
    },
    "fontSize": {
      "display1": "48px",
      "h1": "36px",
      "h2": "28px",
      "h3": "22px",
      "h4": "18px",
      "bodyLarge": "16px",
      "bodyBase": "14px",
      "caption": "12px",
      "badge": "11px"
    },
    "fontWeight": {
      "regular": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700,
      "extrabold": 800
    }
  },
  "pillars": {
    "1": {
      "title": "Pengasuhan yang Aman dan Bermartabat",
      "color": "#145A42",
      "accent": "#C7A45B",
      "icon": "brand/icons/pilar-1-pengasuhan-aman.svg"
    },
    "2": {
      "title": "Kepatuhan Hukum dan Literasi Perlindungan",
      "color": "#145A42",
      "accent": "#C7A45B",
      "icon": "brand/icons/pilar-2-kepatuhan-hukum.svg"
    },
    "3": {
      "title": "Tata Kelola dan Tanggung Jawab Kelembagaan",
      "color": "#145A42",
      "accent": "#C7A45B",
      "icon": "brand/icons/pilar-3-tata-kelola.svg"
    },
    "4": {
      "title": "Sistem Perlindungan dan Pengaduan",
      "color": "#145A42",
      "accent": "#C7A45B",
      "icon": "brand/icons/pilar-4-sistem-pengaduan.svg"
    },
    "5": {
      "title": "Evaluasi dan Perbaikan Berkelanjutan",
      "color": "#145A42",
      "accent": "#C7A45B",
      "icon": "brand/icons/pilar-5-evaluasi-berkelanjutan.svg"
    }
  }
}
